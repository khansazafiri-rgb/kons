# Environment untuk service PocketBase.
# Salin ke /opt/pcv/pocketbase.env lalu isi nilainya:
#   sudo cp deploy/pocketbase.env.example /opt/pcv/pocketbase.env
#   sudo nano /opt/pcv/pocketbase.env
#   sudo chmod 600 /opt/pcv/pocketbase.env

# URL publik aplikasi (dipakai untuk link di email reset password, dll)
APP_URL=https://pcvclassroom.id

# Sandi aplikasi Gmail untuk kirim email notifikasi sign up (SMTP).
# Buat di https://myaccount.google.com/apppasswords (akun khansazafiri@gmail.com).
PCV_SMTP_PASSWORD=isi-sandi-aplikasi-gmail

# Superuser pertama — dibuat otomatis oleh migration saat pertama kali jalan.
# Setelah PocketBase jalan dan kamu bisa login ke /_/, baris ini boleh dihapus.
PB_SUPERUSER_EMAIL=admin@pcvclassroom.id
PB_SUPERUSER_PASSWORD=GANTI-PASSWORD-INI
