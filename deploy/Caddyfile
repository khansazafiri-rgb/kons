# Caddyfile — PCV Classroom
# Pasang: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Domain: pcvclassroom.com (kalau ganti domain lagi nanti, ganti baris
# pertama di bawah — atau pakai IP VPS sementara: ganti jadi ":80" karena
# HTTPS butuh domain). Caddy otomatis mengurus sertifikat HTTPS (Let's Encrypt)
# kalau pakai domain, ASALKAN A record domain sudah mengarah ke IP VPS ini.

pcvclassroom.com, www.pcvclassroom.com {
	encode gzip

	# API + realtime PocketBase
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Dashboard admin PocketBase (https://domainmu/_/)
	handle /_/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Frontend React (hasil `npm run build` di apps/web)
	handle {
		root * /opt/pcv/kons/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
