# Contoh konfigurasi untuk sync korpus ML otomatis (dipakai sync-cron.sh).
# SALIN ke root repo sebagai .ml-sync.env, lalu isi nilainya:
#   cp apps/pptparser/.ml-sync.env.example .ml-sync.env
#   chmod 600 .ml-sync.env          # penting: batasi akses (berisi password)
#
# File .ml-sync.env TIDAK ikut ke git (sudah di-ignore).

# URL PocketBase (biasanya lokal di server yang sama).
PB_URL=http://127.0.0.1:8090

# Kredensial superuser PocketBase.
PB_ADMIN_EMAIL=email-admin@contoh.com
PB_ADMIN_PASSWORD=ganti-dengan-password-admin

# Opsional — hanya isi bila perlu:
# Path biner node bila cron tak menemukannya (cek dengan: which node).
# NODE_BIN=/usr/bin/node
# Paksa proses ulang SEMUA PPT tiap sync (default 1 = hanya yang baru/berubah).
# ML_SYNC_INCREMENTAL=0
# Lokasi folder log (default: apps/pptparser/logs).
# ML_SYNC_LOG_DIR=/var/log/pcv-ml
